# Copy to .env (never commit .env) and adjust.

# --- PostgreSQL (one server, one database per service; databases are created by docker/postgres/init) ---
POSTGRES_USER=change_me_user
POSTGRES_PASSWORD=change_me_1234

# --- Optional: e-mail delivery in notification-service (Gmail SMTP, use an app password) ---
MAIL_USERNAME=
MAIL_PASSWORD=
# If set, low-cash alerts are also e-mailed to this address
ADMIN_EMAIL=
